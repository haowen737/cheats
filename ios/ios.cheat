% ios

# List all simulator devices
xcrun simctl list devices

# List available simulator devices
xcrun simctl list devices available

# List available iPhone simulators only
xcrun simctl list devices available | grep -i iphone

# Boot a simulator
xcrun simctl boot <device_id>

# Boot a simulator and open Simulator app
xcrun simctl boot <device_id> && open -a Simulator

# Shutdown a simulator
xcrun simctl shutdown <device_id>

; --map extracts UUID from selected line, e.g. "iPhone 15 (A1B2C3D4-...)" -> "A1B2C3D4-..."
$ device_id: xcrun simctl list devices available | grep -E '\([-A-F0-9]{36}\)' | sed 's/^ *//' --- --map "echo '{{0}}' | grep -oE '[A-F0-9]{8}-[A-F0-9]{4}-[A-F0-9]{4}-[A-F0-9]{4}-[A-F0-9]{12}'"
