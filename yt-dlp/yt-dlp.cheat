% yt-dlp

# Download best video+audio (merge if needed)
yt-dlp <cookies> <url>

# List available formats
yt-dlp <cookies> -F <url>

# Pick a specific format (use format code from -F)
yt-dlp <cookies> -f <format_id> <url>

# Best video+audio with MP4 output
yt-dlp <cookies> -f "bv*+ba/b" --merge-output-format mp4 <url>

# Limit max resolution (<=720p)
yt-dlp <cookies> -f "bv*[height<=720]+ba/b" <url>

# Exact resolution (fail if not available)
yt-dlp <cookies> -f "bv*[height=1080]+ba/b" <url>

# Prefer a resolution with fallback
yt-dlp <cookies> -S "res:1080" <url>

# Audio only (extract to mp3)
yt-dlp <cookies> -x --audio-format mp3 <url>

# Output filename template
yt-dlp <cookies> -o "%(title)s.%(ext)s" <url>

# Download a playlist (explicit)
yt-dlp <cookies> --yes-playlist <playlist_url>

# Download subtitles (manual and auto)
yt-dlp <cookies> --write-subs --write-auto-subs --sub-lang "en,zh-Hans" <url>

$ cookies: echo -e '--cookies-from-browser chrome\n ' --- --header "Use cookies? (select blank for no)"
